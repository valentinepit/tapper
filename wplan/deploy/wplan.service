[Unit]
Description=WPlan API automation
After=openvpn-client@YOUR_VPN_CONFIG_NAME.service network-online.target
Requires=openvpn-client@YOUR_VPN_CONFIG_NAME.service

[Service]
Type=oneshot
ExecStart=/opt/wplan/wplan-api
EnvironmentFile=/etc/wplan/wplan.env
LoadCredentialEncrypted=wplan_pass:/etc/wplan/wplan_pass.cred

# Создать пользователя перед первым запуском:
#   useradd --system --no-create-home --shell /usr/sbin/nologin wplan
User=wplan
Group=wplan

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
UMask=0077

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

# AF_UNIX нужен для резолвинга имён через systemd-resolved/nscd.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=

# При SIGSYS смотреть, какой вызов заблокирован: journalctl -u wplan | grep -i seccomp
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

# До 3 последовательных запросов к wplan (ClientTimeout total=60 каждый) плюс
# Telegram-уведомление (total=15) - до 195с в худшем случае, отсюда запас.
TimeoutStartSec=240
